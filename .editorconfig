root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ps1,psm1,bat,cmd}]
end_of_line = crlf

[*.{json,yml,yaml}]
indent_size = 2

[*.{md,slang,slangh,h,hpp,cpp}]
trim_trailing_whitespace = false

[*.md]
indent_size = 2
